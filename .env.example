# AI Provider — anthropic | openai | google (default: anthropic)
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001
MATCH_MODEL=claude-sonnet-4-6

# Provider API keys — only the one matching AI_PROVIDER is required
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Supabase
SUPA_PROJECT_URL=https://your-project-ref.supabase.co
SUPA_SERVICE_ROLE=your_supabase_service_role_key_here
# OB1 MCP
MCP_ACCESS_KEY=your_64_char_hex_key_here

# Private endpoint protection
API_KEY=your_private_api_key_here
AUTH_MODE=open   # open | key

# Server
PORT=7000
